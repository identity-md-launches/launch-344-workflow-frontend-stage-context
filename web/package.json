{
  "name": "doomsday-clock-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/deployment.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node scripts/test.mjs",
    "verify": "node scripts/deployment.mjs --check",
    "check:live": "node scripts/live-check.mjs",
    "check:browser-live": "node scripts/browser-live.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
